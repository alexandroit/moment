{
  "name": "@stackline/moment-core",
  "version": "1.0.5",
  "description": "Maintained Moment.js API package for parsing, validating, manipulating, and formatting dates.",
  "homepage": "https://alexandro.net/docs/vanilla/moment/",
  "author": "Alexandroit (https://github.com/alexandroit)",
  "contributors": [
    "Tim Wood <washwithcare@gmail.com> (http://timwoodcreates.com/)",
    "Rocky Meza (http://rockymeza.com)",
    "Matt Johnson <mj1856@hotmail.com> (http://codeofmatt.com)",
    "Isaac Cambron <isaac@isaaccambron.com> (http://isaaccambron.com)",
    "Andre Polykanine <andre@oire.org> (https://github.com/oire)"
  ],
  "keywords": [
    "stackline",
    "npm-package",
    "moment-core",
    "typescript",
    "nodejs",
    "moment",
    "date",
    "datetime",
    "date-parsing",
    "date-formatting",
    "duration",
    "locale",
    "i18n",
    "javascript",
    "browser"
  ],
  "type": "commonjs",
  "main": "./moment.js",
  "module": "./dist/moment.js",
  "jsnext:main": "./dist/moment.js",
  "types": "./moment.d.ts",
  "typings": "./moment.d.ts",
  "typesVersions": {
    ">=3.1": {
      "*": [
        "ts3.1-typings/*"
      ],
      "min/moment-with-locales": [
        "ts3.1-typings/moment.d.ts"
      ]
    }
  },
  "engines": {
    "node": "*"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=20.19.0",
      "onFail": "error"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/moment.git"
  },
  "bugs": {
    "url": "https://github.com/alexandroit/moment/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "dist/",
    "ender.js",
    "locale/",
    "min/locales.js",
    "min/locales.min.js",
    "min/locales.min.js.map",
    "min/moment-with-locales.js",
    "min/moment-with-locales.min.js",
    "min/moment-with-locales.min.js.map",
    "min/moment.min.js",
    "min/moment.min.js.map",
    "moment.d.ts",
    "moment.js",
    "package.js",
    "ts3.1-typings/"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "benchmark": "npm:@stackline/benchmark@1.0.0",
    "es6-promise": "npm:@stackline/es6-promise@1.0.0",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "grunt": "1.6.3",
    "grunt-benchmark": "npm:@stackline/grunt-benchmark@1.0.0",
    "grunt-cli": "npm:@stackline/grunt-cli@1.0.0",
    "grunt-contrib-clean": "npm:@stackline/grunt-contrib-clean@1.0.0",
    "grunt-contrib-concat": "npm:@stackline/grunt-contrib-concat@1.0.0",
    "grunt-contrib-copy": "npm:@stackline/grunt-contrib-copy@1.0.0",
    "grunt-contrib-uglify": "npm:@stackline/grunt-contrib-uglify@1.0.0",
    "grunt-exec": "npm:@stackline/grunt-exec@1.0.0",
    "grunt-karma": "npm:@stackline/grunt-karma@1.0.0",
    "karma": "npm:@stackline/karma@1.0.0",
    "karma-chrome-launcher": "npm:@stackline/karma-chrome-launcher@1.0.0",
    "karma-firefox-launcher": "npm:@stackline/karma-firefox-launcher@1.0.0",
    "karma-qunit": "4.2.1",
    "load-grunt-tasks": "npm:@stackline/load-grunt-tasks@1.0.0",
    "nyc": "18.0.0",
    "prettier": "3.9.6",
    "qunit": "2.26.0",
    "rollup": "4.62.4",
    "typescript": "7.0.2",
    "typescript1": "npm:typescript@1.8.10",
    "typescript2": "npm:typescript@2.9.2",
    "typescript30": "npm:typescript@3.0.3",
    "typescript31": "npm:typescript@3.1.6",
    "typescript3": "npm:typescript@3.9.10",
    "typescript4": "npm:typescript@4.9.5",
    "typescript5": "npm:typescript@5.9.3",
    "typescript6": "npm:typescript@6.0.3",
    "uglify-js": "npm:@stackline/uglify-js@1.0.0"
  },
  "overrides": {
    "lodash": "4.18.1",
    "karma": "$karma"
  },
  "ender": "./ender.js",
  "dojoBuild": "package.js",
  "jspm": {
    "files": [
      "moment.js",
      "moment.d.ts",
      "locale"
    ],
    "map": {
      "moment": "./moment"
    },
    "buildConfig": {
      "uglify": true
    }
  },
  "scripts": {
    "build": "grunt release",
    "build:package": "npm run build",
    "build:docs": "node scripts/build-docs.mjs --all",
    "build:download": "node scripts/build-download.mjs",
    "build:docs:v1.0.0": "node scripts/build-docs.mjs v1.0.0",
    "build:docs:v1.0.1": "node scripts/build-docs.mjs v1.0.1",
    "docs:build": "npm run build:docs",
    "lint": "grunt lint",
    "pack:check": "node scripts/pack-check.mjs",
    "prepack": "npm run build",
    "typescript-test": "npm run typescript-test:1 && npm run typescript-test:2 && npm run typescript-test:3.0 && npm run typescript-test:3.1 && npm run typescript-test:3.9 && npm run typescript-test:4 && npm run typescript-test:5 && npm run typescript-test:6 && npm run typescript-test:latest",
    "typescript-test:1": "node node_modules/typescript1/lib/tsc.js --project typing-tests",
    "typescript-test:2": "node node_modules/typescript2/lib/tsc.js --project typing-tests --types empty --typeRoots typing-tests/types",
    "typescript-test:3.0": "node node_modules/typescript30/lib/tsc.js --project typing-tests --types empty --typeRoots typing-tests/types",
    "typescript-test:3.1": "node node_modules/typescript31/lib/tsc.js --project ts3.1-typing-tests",
    "typescript-test:3.9": "node node_modules/typescript3/lib/tsc.js --project ts3.1-typing-tests",
    "typescript-test:4": "node node_modules/typescript4/lib/tsc.js --project ts3.1-typing-tests",
    "typescript-test:5": "node node_modules/typescript5/lib/tsc.js --project ts3.1-typing-tests",
    "typescript-test:6": "node node_modules/typescript6/lib/tsc.js --project ts3.1-typing-tests",
    "typescript-test:latest": "node node_modules/typescript/lib/tsc.js --project ts3.1-typing-tests",
    "test": "grunt test",
    "test:browser": "grunt test:browser",
    "test:node": "grunt test:node",
    "test:types": "npm run typescript-test",
    "check": "npm run lint && npm test && npm run build && npm run build:docs && npm run build:download && npm run pack:check && npm audit --omit=dev",
    "eslint": "eslint Gruntfile.js tasks src",
    "prettier-check": "prettier --check Gruntfile.js tasks src",
    "prettier-fmt": "prettier --write Gruntfile.js tasks src",
    "coverage": "nyc npm run test:node && nyc report --reporter=text --reporter=lcov"
  },
  "spm": {
    "main": "moment.js",
    "output": [
      "locale/*.js"
    ]
  }
}
