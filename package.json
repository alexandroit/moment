{
    "name": "@revivejs/moment",
    "version": "2.30.5",
    "description": "Maintained Moment.js 2.30.x fork for parsing, validating, manipulating, and formatting dates.",
    "homepage": "https://alexandroit.github.io/moment/",
    "author": "Alexandroit (https://github.com/alexandroit)",
    "contributors": [
        "Tim Wood <washwithcare@gmail.com> (http://timwoodcreates.com/)",
        "Rocky Meza (http://rockymeza.com)",
        "Matt Johnson <mj1856@hotmail.com> (http://codeofmatt.com)",
        "Isaac Cambron <isaac@isaaccambron.com> (http://isaaccambron.com)",
        "Andre Polykanine <andre@oire.org> (https://github.com/oire)"
    ],
    "keywords": [
        "moment",
        "date",
        "time",
        "datetime",
        "date-library",
        "date-parsing",
        "date-formatting",
        "duration",
        "timezone",
        "locale",
        "i18n",
        "typescript",
        "javascript",
        "npm-package",
        "revived",
        "maintained",
        "legacy-compatible"
    ],
    "main": "./moment.js",
    "module": "./dist/moment.js",
    "jsnext:main": "./dist/moment.js",
    "types": "./moment.d.ts",
    "typings": "./moment.d.ts",
    "typesVersions": {
        ">=3.1": {
            "*": [
                "ts3.1-typings/*"
            ],
            "min/moment-with-locales": [
                "ts3.1-typings/moment.d.ts"
            ]
        }
    },
    "engines": {
        "node": "*"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/alexandroit/moment.git"
    },
    "bugs": {
        "url": "https://github.com/alexandroit/moment/issues"
    },
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "CHANGELOG.md",
        "LICENSE",
        "README.md",
        "dist/",
        "ender.js",
        "locale/",
        "min/",
        "moment.d.ts",
        "moment.js",
        "package.js",
        "ts3.1-typings/"
    ],
    "devDependencies": {
        "@eslint/js": "9.39.4",
        "@types/node": "17.0.21",
        "benchmark": "2.1.4",
        "coveralls": "3.1.1",
        "cross-env": "6.0.3",
        "es6-promise": "4.2.8",
        "eslint": "9.39.4",
        "globals": "17.4.0",
        "grunt": "1.6.1",
        "grunt-benchmark": "1.0.0",
        "grunt-cli": "1.4.3",
        "grunt-contrib-clean": "2.0.1",
        "grunt-contrib-concat": "2.1.0",
        "grunt-contrib-copy": "1.0.0",
        "grunt-contrib-uglify": "5.2.2",
        "grunt-contrib-watch": "1.1.0",
        "grunt-env": "1.0.1",
        "grunt-exec": "3.0.0",
        "grunt-karma": "4.0.2",
        "grunt-nuget": "0.3.1",
        "grunt-string-replace": "1.3.3",
        "karma": "6.4.2",
        "karma-chrome-launcher": "3.2.0",
        "karma-firefox-launcher": "2.1.2",
        "karma-qunit": "4.1.2",
        "karma-sauce-launcher": "4.1.4",
        "load-grunt-tasks": "5.1.0",
        "lodash": "4.17.21",
        "node-qunit": "2.0.0",
        "nyc": "15.1.0",
        "prettier": "3.1.1",
        "qunit": "^2.10.0",
        "rollup": "3.30.0",
        "typescript": "1.8.10",
        "typescript3": "npm:typescript@3.9.10",
        "uglify-js": "3.17.4"
    },
    "ender": "./ender.js",
    "dojoBuild": "package.js",
    "jspm": {
        "files": [
            "moment.js",
            "moment.d.ts",
            "locale"
        ],
        "map": {
            "moment": "./moment"
        },
        "buildConfig": {
            "uglify": true
        }
    },
    "scripts": {
        "build": "grunt release",
        "build:package": "npm run build",
        "build:docs": "node scripts/build-docs.mjs v2.30.5",
        "build:docs:all": "node scripts/build-docs.mjs --all",
        "build:docs:v2.30.2": "node scripts/build-docs.mjs v2.30.2",
        "build:docs:v2.30.3": "node scripts/build-docs.mjs v2.30.3",
        "build:docs:v2.30.4": "node scripts/build-docs.mjs v2.30.4",
        "build:docs:v2.30.5": "node scripts/build-docs.mjs v2.30.5",
        "docs:build": "npm run build:docs",
        "lint": "grunt lint",
        "pack:check": "npm pack --dry-run",
        "prepack": "npm run build",
        "ts3.1-typescript-test": "cross-env node_modules/typescript3/bin/tsc --project ts3.1-typing-tests",
        "typescript-test": "cross-env node_modules/typescript/bin/tsc --project typing-tests",
        "test": "grunt test",
        "test:browser": "grunt test:browser",
        "test:node": "grunt test:node",
        "test:types": "grunt test:typescript test:typescript-3.1",
        "eslint": "eslint Gruntfile.js tasks src",
        "prettier-check": "prettier --check Gruntfile.js tasks src",
        "prettier-fmt": "prettier --write Gruntfile.js tasks src",
        "coverage": "nyc npm test && nyc report",
        "coveralls": "nyc npm test && nyc report --reporter=text-lcov | coveralls"
    },
    "spm": {
        "main": "moment.js",
        "output": [
            "locale/*.js"
        ]
    }
}
